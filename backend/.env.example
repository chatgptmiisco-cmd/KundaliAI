# Copy this file to .env and fill in real values for anything beyond local dev.
# Every setting has a working default (see app/core/config.py) — .env only
# needs to override what you actually want to change.

ENVIRONMENT=dev

# --- Database ---
# Default is a local SQLite file (zero setup). Point this at Postgres for
# anything beyond local dev — no code changes needed, just the URL:
#   DATABASE_URL=postgresql+asyncpg://user:password@host:5432/kundaliai
DATABASE_URL=sqlite+aiosqlite:///./kundaliai.db

# --- Auth ---
# Generate a real one for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me

# --- PII encryption (birth data at rest) ---
# Must be a valid Fernet key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# The default below is PUBLIC (checked into source) — never use it beyond local dev.
PII_ENCRYPTION_KEY=2llRqH9W5eM8KcuMH4PLPoaF945mietzNdVHwbDothE=

# --- LLM (Anthropic Claude) ---
# Astrology is fixed calculation (Swiss Ephemeris + classical rules) — every
# chart/dasha/Manglik/Guna Milan number is computed, never AI-guessed. The
# only optional AI role is turning those numbers into prose, and it's OFF by
# default: setting ANTHROPIC_API_KEY alone does nothing — USE_AI_INTERPRETATION
# must also be explicitly set to true, or every explanation renders via the
# deterministic template interpreter (pure Python, no network call).
USE_AI_INTERPRETATION=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Feature gating ---
# Every subscription-gated feature (D9/D10 charts, unlimited period analyses,
# real AI chat, voice narration) is unlocked for every tier while pricing
# isn't live yet. Flip to false to turn paywalls back on — the tier/plan
# machinery itself is untouched either way.
ALL_FEATURES_FREE=true

# --- Payments (Razorpay) ---
# Leave unset to run in simulate mode (checkout always succeeds locally, no
# real payment gateway call).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Voice (STT/TTS) ---
# Only "stub" is implemented right now — see app/services/voice/{stt,tts}.py
# for how to add a real provider.
STT_PROVIDER=stub
TTS_PROVIDER=stub

# --- Free-tier quota ---
FREE_MONTHLY_PERIOD_ANALYSES=3

# --- CORS ---
# Comma-separated is NOT supported here since this is parsed as a JSON list
# by pydantic-settings; set via an actual .env array syntax if you need to
# restrict this, e.g.: CORS_ALLOW_ORIGINS=["https://yourapp.com"]
CORS_ALLOW_ORIGINS=["*"]
